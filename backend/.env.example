APP_NAME=Centinela
API_VERSION=1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Documentos / Storage / Queue (modulo Jorge)
# Vacios en local: se usan los adaptadores en memoria.
# Para Azure: definir la connection string O la account URL (Managed Identity).
STORAGE_CONNECTION_STRING=
STORAGE_ACCOUNT_URL=
BLOB_CONTAINER=documents
DOCUMENTS_QUEUE=documents
MAX_DOCUMENT_MB=5
ALLOWED_DOCUMENT_TYPES=application/pdf,image/png,image/jpeg
