APP_NAME=Centinela
API_VERSION=1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Documentos / Storage / Queue (modulos Jorge + Samuel + Camila)
# Vacios en local: se usan los adaptadores en memoria.
# Para Azure: definir STORAGE_ACCOUNT (nombre) -> se derivan los endpoints
# blob y queue; o una STORAGE_CONNECTION_STRING para local.
STORAGE_ACCOUNT=
STORAGE_CONNECTION_STRING=
BLOB_CONTAINER=documents
DOCUMENTS_QUEUE=documents
# Cola de eventos API → scoring (alias QUEUE_NAME para Azure Functions)
TRANSACTIONS_QUEUE=transactions
QUEUE_NAME=transactions
# Cola durable scoring → gestión de casos
CASES_QUEUE=cases
MAX_DOCUMENT_MB=5
ALLOWED_DOCUMENT_TYPES=application/pdf,image/png,image/jpeg

# Seguridad (modulo Lukas)
# AUTH_ENABLED=false en local para no exigir clave; true en Azure.
AUTH_ENABLED=false
# Mapa "clave:rol" separado por comas. En Azure vienen de Key Vault.
# Roles: administrador | analista | auditor | servicio
API_KEYS=
KEY_VAULT_URL=

# Cosmos DB (historial de transacciones por cuenta — módulo Camila)
# Vacío en local => adaptadores en memoria. En Azure: endpoint + MI (sin key)
# o COSMOS_KEY solo en local, nunca en el repo.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=centinela
COSMOS_CONTAINER=transactions
