# =============================================================================
# CENTINELA — Motor de scoring de fraude (imagen multi-stage)
# =============================================================================
# Mismo patrón que Dockerfile.api, pero con un cierre de dependencias distinto:
# el worker no sirve HTTP, así que su imagen no lleva fastapi, uvicorn,
# starlette, python-multipart, Blob Storage ni Key Vault. Esa diferencia es la
# razón de mantener dos requirements en vez de uno compartido.
#
# Secretos: CERO. Ningún ARG ni COPY con credenciales; la configuración llega en
# ejecución desde Container Apps (referencias a Key Vault + Managed Identity).
#
# Build:  docker build -f backend/Dockerfile.worker -t centinela-worker:dev backend
# =============================================================================

# --- Etapa 1: builder --------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

COPY requirements-worker.txt ./
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --no-compile -r requirements-worker.txt && \
    /opt/venv/bin/pip uninstall --yes pip setuptools wheel 2>/dev/null || true && \
    find /opt/venv -name '__pycache__' -type d -prune -exec rm -rf {} + && \
    find /opt/venv -name '*.pyc' -delete

# --- Etapa 2: runtime --------------------------------------------------------
FROM python:3.12-slim AS runtime

LABEL org.opencontainers.image.title="centinela-worker" \
      org.opencontainers.image.description="Motor de scoring de fraude de CENTINELA" \
      org.opencontainers.image.source="https://github.com/marespi21/CENTINELA" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Usuario sin privilegios + borrado del pip de la imagen base (ver Dockerfile.api).
RUN groupadd --gid 10001 centinela && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin centinela && \
    rm -rf /usr/local/lib/python3.12/site-packages/pip \
           /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
           /usr/local/lib/python3.12/site-packages/setuptools \
           /usr/local/lib/python3.12/site-packages/setuptools-*.dist-info \
           /usr/local/lib/python3.12/site-packages/pkg_resources \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=10001:10001 app ./app

USER 10001:10001

# Sin HEALTHCHECK: este contenedor no expone puerto. Su salud se observa por la
# telemetría (contadores de mensajes) y por la longitud de la cola que vigila
# KEDA; una sonda sintética no aportaría información nueva.
#
# `exec` no hace falta aquí porque no hay shell intermedio: el proceso Python
# recibe SIGTERM como PID 1 y lo atiende (apagado limpio antes de escalar a 0).
CMD ["python", "-m", "app.presentation.worker.main"]
