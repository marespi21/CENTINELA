# ============================================================================
# Centinela API - environment configuration
# Copy this file to `.env` before running `docker compose up`:
#   cp .env.example .env
# ============================================================================

# Run mode: "local" (Azurite emulator) or "azure" (DefaultAzureCredential +
# Key Vault). Local is the default and the only active mode in Week 1.
APP_ENV=local

# --- App metadata (shown in Swagger /docs) ----------------------------------
APP_NAME=Centinela API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Log output format: "console" (human-readable, for local) or "json"
# (structured, for Azure log ingestion). Defaults to console in local mode.
LOG_FORMAT=console

# --- Local mode: Azurite -----------------------------------------------------
# Public, well-known Azurite development credentials (safe to commit).
# Endpoints target the docker-compose service host `azurite` (blob 10000,
# queue 10001) - NOT 127.0.0.1, because the API runs in a separate container.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;

# --- Storage resource names --------------------------------------------------
BLOB_CONTAINER_TRANSACTIONS=transactions
BLOB_CONTAINER_UPLOADS=uploads
QUEUE_TRANSACTIONS=transactions

# --- Azure mode only (implemented, NOT active in Week 1) ---------------------
# Name of the Key Vault holding real secrets. The storage connection string is
# read from the secret named below using DefaultAzureCredential.
KEY_VAULT_NAME=
KEY_VAULT_STORAGE_SECRET=storage-connection-string
