# URL de la API FastAPI (usada por el BFF en el servidor).
# Visible en el bundle solo como base pública; la clave NO va aquí.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Override opcional solo servidor (prioridad sobre NEXT_PUBLIC_API_BASE)
# API_BASE_URL=http://localhost:8000

# API key de analista — SOLO servidor. Nunca NEXT_PUBLIC_*.
ANALYST_API_KEY=ana-key
